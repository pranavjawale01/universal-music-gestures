<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Header with Title and Upper Right Permission Circles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/onSurface"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Intelligent Off-Screen Control"
                        android:textSize="13sp"
                        android:textColor="@color/onSurfaceVariant"/>
                </LinearLayout>

                <!-- Upper Right Permission Badges -->
                <LinearLayout
                    android:id="@+id/layoutPermissionsHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <!-- Media Listener Permission Badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/badgePermMedia"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        app:cardCornerRadius="17dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1.5dp"
                        app:strokeColor="#33FFFFFF"
                        app:cardBackgroundColor="#EF4444"
                        android:layout_marginEnd="6dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_perm_media"
                            app:tint="#FFFFFF"
                            android:contentDescription="Media Access Permission"/>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Overlay Permission Badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/badgePermOverlay"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        app:cardCornerRadius="17dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1.5dp"
                        app:strokeColor="#33FFFFFF"
                        app:cardBackgroundColor="#EF4444"
                        android:layout_marginEnd="6dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_perm_overlay"
                            app:tint="#FFFFFF"
                            android:contentDescription="Overlay Permission"/>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Battery Optimization Badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/badgePermBattery"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        app:cardCornerRadius="17dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1.5dp"
                        app:strokeColor="#33FFFFFF"
                        app:cardBackgroundColor="#EF4444">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_perm_battery"
                            app:tint="#FFFFFF"
                            android:contentDescription="Battery Optimization Permission"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- 1. Enable Sense Gestures Block (with all Active Gestures inside) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMaster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardElevation="0dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Master Switch Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/master_toggle"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/onSurface"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Draw shapes to control your music"
                                android:textSize="12sp"
                                android:textColor="@color/onSurfaceVariant"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchMaster"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Divider inside Master block -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1AFFFFFF"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="12dp"/>

                    <!-- Active Gestures Inside Sense Block -->
                    <TextView
                        android:id="@+id/txtGestureTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE GESTURES"
                        android:textSize="12sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkNext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/gesture_next_title"
                        android:textColor="@color/onSurface"
                        android:padding="8dp"/>

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkPrev"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/gesture_prev_title"
                        android:textColor="@color/onSurface"
                        android:padding="8dp"/>

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkPause"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/gesture_pause_title"
                        android:textColor="@color/onSurface"
                        android:padding="8dp"/>

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkVolUp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Volume Up +10% ( Clockwise Circle ↻ )"
                        android:textColor="@color/onSurface"
                        android:padding="8dp"/>

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkVolDown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Volume Down -10% ( Anticlockwise Circle ↺ )"
                        android:textColor="@color/onSurface"
                        android:padding="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Gesture Control Mode Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardElevation="0dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gesture Control Mode"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/onSurface"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Choose how you interact with gestures"
                        android:textSize="12sp"
                        android:textColor="@color/onSurfaceVariant"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleGroupMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnModeLock"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Lock Screen"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnModeAnywhere"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Within App"/>
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- Auto-Activate Switch Row -->
                    <LinearLayout
                        android:id="@+id/cardAuto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/auto_lock_title"
                                android:textSize="14sp"
                                android:textColor="@color/onSurface"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/auto_lock_desc"
                                android:textSize="11sp"
                                android:textColor="@color/onSurfaceVariant"/>
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchAuto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Visual Effects & Edge Lighting Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEdge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardElevation="0dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/edge_lighting_title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/onSurface"/>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchEdge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/edge_lighting_desc"
                        android:textSize="12sp"
                        android:textColor="@color/onSurfaceVariant"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Test Gesture Mode Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartSense"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Test Sense Gesture Mode Now"
                android:textSize="15sp"
                app:cornerRadius="18dp"
                android:backgroundTint="@color/primary"
                android:textColor="@color/onPrimary"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
